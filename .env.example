# Supabase Public Credentials (optional for local-first mode, required for cloud sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Edge Function / Telegram Bot Credentials (used in Supabase Edge Functions environment)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# TELEGRAM_DEFAULT_CHAT_ID=your-personal-chat-id
# APP_BASE_URL=https://your-studyflow-domain.vercel.app
